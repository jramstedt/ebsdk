CFG = $(firstword $(subst :, ,$(CP_CFG)))/
EXE = $(firstword $(subst :, ,$(CP_EXE)))/
INC = $(firstword $(subst :, ,$(CP_INC)))/
LIS = $(firstword $(subst :, ,$(CP_LIS)))/
OBJ = $(firstword $(subst :, ,$(CP_OBJ)))/
PSRC = $(word 2, $(subst :, ,$(CP_SRC)))/
SRC = $(firstword $(subst :, ,$(CP_SRC)))/

# https://www.gnu.org/software/make/manual/html_node/General-Search.html
VPATH = $(CP_SRC)

.PHONY: default

default : setup
	$(error You have to explicitly specify a target)

# Pick up the definitions for $(platform), $(arch), and optionally $(config).
# Options also have macros defined, if they are nonzero.
include $(CFG)macros.make

# Standard cross-compiler and tool setup.
include	setup.make

# Pull in the GEMCC file dependencies generated by newbuild.sh.
include	$(CFG)depend.make

# Pull in the object file dependencies generated by NEWBUILD.COM.
include	$(CFG)objects.make

include platform_$(call LC,$(platform)).make

ifdef custom_config
	include $(CFG)config_$(config).make
endif
